---
/**
 * StrategyCards — Figma 133:2137 → 286:9535 (wholesale landing).
 * Cream band, H3 title + intro, three cards: gradient band (ladder colour)
 * with orange kicker, H4 white title and a round photo with circle outline
 * overflowing top-right; white body with description, hero stat (36px navy),
 * two facts on a rule, primary "View strategy". Card-body labels are rust-hi,
 * not the frame's orange: orange on white is 2.9:1 (T23, WCAG AA). Mobile stacks; the intro is
 * omitted because the mobile frame carries it in a separate Statement.
 */
import Button from "./Button.astro";
import type { Strategy } from "../content/loaders";
interface Props { title: string; intro: string; strategies: Strategy[]; buttonLabel: string; hrefs: Record<string, string>; images: Record<string, string>; }
const { title, intro, strategies, buttonLabel, hrefs, images } = Astro.props;
---
<section class="bg-cream">
  <div class="mx-auto flex max-w-site flex-col gap-6 px-4 pb-6 pt-2 md:gap-9 md:px-12 md:pb-[50px] md:pt-[90px]">
    <div class="hidden flex-col gap-3 md:flex">
      <h2 class="text-h5 font-medium text-navy md:text-h3">{title}</h2>
      <p>{intro}</p>
    </div>
    <div class="flex flex-col gap-6 md:grid md:grid-cols-3 md:gap-8">
      {strategies.map((s) => (
        <article class="flex flex-col overflow-hidden rounded-lg border border-card-line bg-white">
          <div class="relative flex min-h-[176px] flex-col justify-center overflow-hidden px-7 py-8 text-white" style={`background: var(--gradient-ladder-${s.ladder});`}>
            <div class="pointer-events-none absolute right-[-40px] top-1/2 h-[312px] w-[156px] -translate-y-1/2 translate-x-[8px] rotate-[-45deg] rounded-full border border-outline-card" aria-hidden="true"></div>
            <img src={images[s.slug]} alt="" width="244" height="244" loading="lazy" class="pointer-events-none absolute right-[-72px] top-1/2 h-[244px] w-[244px] -translate-y-1/2 rounded-full object-cover" />
            <div class="relative flex flex-col gap-2.5">
              <p class="text-kicker font-semibold uppercase tracking-kicker text-orange">{s.card.kicker}</p>
              <h3 class="max-w-[200px] text-h5 font-medium">{s.card.title}</h3>
            </div>
          </div>
          <div class="flex flex-1 flex-col gap-6 px-7 pb-[30px] pt-[26px]">
            <div class="flex flex-1 flex-col gap-[22px]">
              <p>{s.card.body}</p>
              <div class="flex flex-col gap-1.5">
                <p class="text-kicker font-semibold uppercase tracking-kicker text-rust-hi">{s.card.heroStat[0]}</p>
                <p class="text-h2 font-medium text-navy">{s.card.heroStat[1]}</p>
              </div>
              <dl class="flex gap-6 border-t border-card-line pt-[18px]">
                {s.card.facts.map(([k, v]) => <div class="flex flex-1 flex-col gap-1"><dt class="text-kicker font-semibold uppercase tracking-kicker text-rust-hi">{k}</dt><dd class="text-h6 font-medium text-navy">{v}</dd></div>)}
              </dl>
            </div>
            <div class="mt-auto"><Button label={buttonLabel} href={hrefs[s.slug]} /></div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
