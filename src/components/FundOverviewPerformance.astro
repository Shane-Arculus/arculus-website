---
/**
 * FundOverviewPerformance — Figma 88:828 → 207:17684 (AFI), 97:1110 → 207:17732 (PIF).
 * Cream band. About the Fund (H3 + 22px body), RatingsRow, then Performance:
 * H3 + note, the chart image bare on the cream band (desktop only) beside the
 * period table in a white card. Mobile: About, ratings card, Performance, table card.
 * Also serves the wholesale strategy pages' "About the strategy" + At a glance
 * block when passed `ratings={false}` (107:859).
 */
import Section from "./Section.astro";
import RatingsRow from "./RatingsRow.astro";
import ChartImage from "./ChartImage.astro";
import PerformanceTable from "./PerformanceTable.astro";
interface Props {
  about: { title: string; body: string };
  ratingReportUrl?: string;
  performance: { title: string; note: string; chartTitle: string; chartImage: string; chartSeries: readonly string[]; tableTitle: string; table: { columns: readonly string[]; rows: readonly (readonly string[])[] }; tableNote?: string; performanceAsAt: string };
  fundName: string;
}
const { about, ratingReportUrl, performance, fundName } = Astro.props;
---
<Section bg="cream" pad="none" class="pb-10 md:pb-[50px]">
  <div class="flex flex-col gap-9 px-4 pt-10 md:gap-[50px] md:px-12 md:pt-[50px]">
    <div class="flex flex-col gap-6 md:gap-5 md:pr-12">
      <h2 class="text-h5 font-medium text-navy md:text-h3">{about.title}</h2>
      <p class="text-body text-body md:text-base-lg">{about.body}</p>
    </div>
    {ratingReportUrl && <RatingsRow reportUrl={ratingReportUrl} />}
    <div class="flex flex-col gap-6 md:gap-5">
      <h2 class="text-h5 font-medium text-navy md:text-h3">{performance.title}</h2>
      <p class="text-body text-body">{performance.note}</p>
      <div class="flex flex-col gap-6 md:flex-row md:items-start md:gap-6">
        <ChartImage src={performance.chartImage} alt={`${performance.chartTitle}, ${fundName}, to ${performance.performanceAsAt}`} series={performance.chartSeries} class="md:w-[664px] md:shrink-0" />
        <div class="flex-1 rounded-lg border border-card-line bg-white p-6 md:px-9 md:py-7"><PerformanceTable title={performance.tableTitle} columns={performance.table.columns} rows={performance.table.rows} note={performance.tableNote} /></div>
      </div>
    </div>
  </div>
</Section>
