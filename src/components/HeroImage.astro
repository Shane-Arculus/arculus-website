---
/**
 * HeroImage — the ellipse-clipped photo with its thin outline ring, as on
 * every hero in the file (home 123:31755, funds 88:13064, wholesale 105:30977,
 * IM 170:3292, mobile 74:18518). Geometry is Figma's, not an approximation:
 * the photo is clipped to the file's lens path (a 45°-leaning ellipse in a
 * square of `size`); the ring is the SAME lens path drawn in a 0.64 × 1.277
 * box (372 × 742 at 581) and rotated 45°, so it is long and thin and crosses
 * the photo, poking out top-left and bottom-right. Coordinates below are the
 * frames' own, in a 581 viewBox with the photo at 0,0 — the ring's position
 * relative to the photo is identical on every desktop and mobile hero frame.
 * 30 Sep (Jim): the earlier CSS ellipse (rounded div) read as an oval and was
 * wrong; the ring sits behind the photo. Stroke 2 at 581, scaling with `size`.
 * Colours: warm #DFC6AD on light heroes, #8D93AC on navy heroes (Figma).
 */
interface Props {
  src: string;
  alt: string;
  /** square size of the clipped photo, px */
  size?: number;
  /** ring colour token, e.g. border-outline-warm (light) | border-outline-card (navy) */
  outline?: string;
  class?: string;
}
const { src, alt, size = 581, outline = "border-outline-warm", class: className = "" } = Astro.props;
// accepts the old border-* token names so callers need not change; literal
// class names so Tailwind generates them
const ringColours: Record<string, string> = {
  "border-outline-warm": "text-outline-warm",
  "border-outline-card": "text-outline-card",
  "border-outline-decor": "text-outline-decor",
};
const ringColour = ringColours[outline] ?? "text-outline-warm";
const id = `hero-clip-${Math.random().toString(36).slice(2, 8)}`;
---
<div class:list={["relative", className]} style={`width:${size}px;height:${size}px`}>
  <svg width="0" height="0" class="absolute" aria-hidden="true">
    <defs>
      <clipPath id={id} clipPathUnits="objectBoundingBox">
        <path d="M0.8079 0.1920 C1.0255 0.4095 1.0640 0.7238 0.8939 0.8939 C0.7238 1.0640 0.4095 1.0255 0.1920 0.8079 C-0.0255 0.5905 -0.0640 0.2762 0.1061 0.1061 C0.2762 -0.0640 0.5905 -0.0255 0.8079 0.1920 Z" />
      </clipPath>
    </defs>
  </svg>
  <svg viewBox="0 0 581 581" class:list={["pointer-events-none absolute inset-0 h-full w-full overflow-visible", ringColour]} aria-hidden="true" focusable="false">
    <path transform="matrix(0.70711 -0.70711 0.70711 0.70711 -108.332 164.066)" fill="none" stroke="currentColor" stroke-width="2" d="M300.439 142.483C381.324 303.886 395.624 537.039 332.377 663.244C269.131 789.449 152.289 760.916 71.404 599.512C-9.482 438.109 -23.781 204.956 39.465 78.751C102.712 -47.454 219.553 -18.921 300.439 142.483Z" />
  </svg>
  <img src={src} alt={alt} width={size} height={size} loading="eager" fetchpriority="high" decoding="async" class="relative block h-full w-full object-cover" style={`clip-path:url(#${id})`} />
</div>
