---
/**
 * HeroImage — the ellipse-clipped photo with a thin rotated outline, as on
 * every hero in the file (home 123:31755, funds 88:13040, About 159:3161,
 * wholesale strategies 104:1684). Geometry from Figma: the photo is clipped to
 * an ellipse rotated 45° (long axis top-left → bottom-right) that fits a square
 * of `size`; the outline is a second ellipse, half as wide as it is tall,
 * sharing the same centre. Verified 16 Sep against the frames: every hero in
 * the file leans top-left → bottom-right. Sizes: full 581 (outline 372×742), compact 444
 * (284×567), mobile 390 (180×360, offset up-right and cropped by the band).
 */
interface Props {
  src: string;
  alt: string;
  /** square size of the clipped photo, px */
  size?: number;
  /** outline colour token class, e.g. border-outline-warm | border-outline-decor */
  outline?: string;
  class?: string;
}
const { src, alt, size = 581, outline = "border-outline-warm", class: className = "" } = Astro.props;
const ow = Math.round(size * 0.64), oh = Math.round(size * 1.277);
const id = `hero-clip-${Math.random().toString(36).slice(2, 8)}`;
---
<div class:list={["relative", className]} style={`width:${size}px;height:${size}px`}>
  <svg width="0" height="0" class="absolute" aria-hidden="true">
    <defs>
      <clipPath id={id} clipPathUnits="objectBoundingBox">
        <path d="M0.8079 0.1920 C1.0255 0.4095 1.0640 0.7238 0.8939 0.8939 C0.7238 1.0640 0.4095 1.0255 0.1920 0.8079 C-0.0255 0.5905 -0.0640 0.2762 0.1061 0.1061 C0.2762 -0.0640 0.5905 -0.0255 0.8079 0.1920 Z" />
      </clipPath>
    </defs>
  </svg>
  <div class:list={["pointer-events-none absolute left-1/2 top-1/2 rounded-full border", outline]} style={`width:${ow}px;height:${oh}px;transform:translate(-50%,-50%) rotate(-45deg)`} aria-hidden="true"></div>
  <img src={src} alt={alt} width={size} height={size} loading="eager" decoding="async" class="block h-full w-full object-cover" style={`clip-path:url(#${id})`} />
</div>
