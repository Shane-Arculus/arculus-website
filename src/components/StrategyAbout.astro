---
/**
 * StrategyAbout — Figma 107:859 → 207:17863 (the strategy pages' variant of
 * fund-overview-performance, no ratings). White band, 90px vertical padding:
 * "About the strategy" left; "At a glance" right with the note and a cream
 * card of KeyValueList terms. Mobile stacks. Also IM's "About the service".
 */
import KeyValueList from "./KeyValueList.astro";
interface Props { about: { title: string; paragraphs: readonly string[] }; glance: { title: string; note: string; items: readonly (readonly [string, string])[] }; }
const { about, glance } = Astro.props;
---
<section class="bg-white">
  <div class="mx-auto flex max-w-site flex-col gap-8 px-4 py-10 md:grid md:grid-cols-2 md:gap-4 md:px-12 md:py-[90px]">
    <div class="flex flex-col gap-4 md:gap-9 md:pr-12">
      <h2 class="text-h5 font-medium text-navy md:text-h3">{about.title}</h2>
      <div class="flex flex-col gap-4">{about.paragraphs.map((p) => <p>{p}</p>)}</div>
    </div>
    <div class="flex flex-col gap-4 md:gap-9">
      <h2 class="text-h5 font-medium text-navy md:text-h3">{glance.title}</h2>
      <p>{glance.note}</p>
      <div class="rounded-lg bg-cream px-6 pb-6 pt-4 md:px-9 md:pb-9 md:pt-6"><KeyValueList rows={glance.items} caption={glance.title} /></div>
    </div>
  </div>
</section>
