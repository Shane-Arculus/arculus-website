---
/**
 * FilterTabs — Figma 175:11893 → 210:14277 (Insights), 186:3624 (Documents,
 * with a "Search documents" field right), 191:5006 (Search). Row of 15px tabs
 * on a 1px rule; active tab rust SemiBold. Filters elements carrying
 * `data-filter-item="<slug>"` inside the element with id `target` (client-side,
 * no framework); "All" shows everything. Reads `?filter=` on load so links
 * like /insights?filter=research work. With `search`, the field narrows the
 * same items by their `data-filter-text` (or text content); a container marked
 * `data-filter-section` hides when all its items are hidden, and an element
 * marked `data-filter-empty` shows when nothing at all matches.
 */
import { slugify } from "../lib/format";
import Icon from "./Icon.astro";
interface Props { tabs: readonly string[]; target: string; bg?: "white" | "cream"; search?: { placeholder: string; label?: string }; }
const { tabs, target, bg = "white", search } = Astro.props;
---
<div class:list={[bg === "cream" ? "bg-cream" : "bg-white"]} data-filter-tabs={target}>
  <div class="mx-auto max-w-site px-4 pt-6 md:px-12 md:pt-8">
    <div class="flex flex-col gap-4 border-b border-line pb-3 md:flex-row md:items-center md:justify-between md:gap-8">
      <div role="tablist" class="flex gap-6 overflow-x-auto md:gap-8">
        {tabs.map((t, i) => (
          <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-filter={i === 0 ? "all" : slugify(t)} class="shrink-0 whitespace-nowrap text-body text-body hover:text-navy aria-selected:font-semibold aria-selected:text-rust">{t}</button>
        ))}
      </div>
      {search && (
        <label class="relative block md:w-[320px] md:shrink-0">
          <span class="sr-only">{search.label ?? search.placeholder}</span>
          <input type="search" data-filter-search placeholder={search.placeholder} autocomplete="off" class="h-12 w-full rounded-[3px] border border-line bg-white px-4 pr-11 text-body text-ink placeholder:text-muted focus:border-navy focus:outline-none" />
          <Icon name="search" size={18} class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-body" />
        </label>
      )}
    </div>
  </div>
</div>
<script>
  for (const bar of document.querySelectorAll<HTMLElement>("[data-filter-tabs]")) {
    const target = document.getElementById(bar.dataset.filterTabs!);
    if (!target) continue;
    const tabs = Array.from(bar.querySelectorAll<HTMLButtonElement>("[data-filter]"));
    const search = bar.querySelector<HTMLInputElement>("[data-filter-search]");
    let filter = "all";
    const apply = () => {
      const q = (search?.value ?? "").trim().toLowerCase();
      for (const t of tabs) t.setAttribute("aria-selected", String(t.dataset.filter === filter));
      for (const el of target.querySelectorAll<HTMLElement>("[data-filter-item]")) {
        const tabOk = filter === "all" || el.dataset.filterItem === filter;
        const textOk = !q || (el.dataset.filterText ?? el.textContent ?? "").toLowerCase().includes(q);
        const collapsed = el.hasAttribute("data-docs-extra") && filter === "all" && !q; // rows behind a see-more expander stay folded until a filter or search applies
        el.classList.toggle("hidden", !(tabOk && textOk) || collapsed);
      }
      for (const s of target.querySelectorAll<HTMLElement>("[data-filter-section]")) {
        const items = Array.from(s.querySelectorAll<HTMLElement>("[data-filter-item]"));
        s.classList.toggle("hidden", items.length > 0 && items.every((el) => el.classList.contains("hidden")));
      }
      const empty = target.querySelector<HTMLElement>("[data-filter-empty]");
      if (empty) empty.classList.toggle("hidden", Array.from(target.querySelectorAll<HTMLElement>("[data-filter-item]")).some((el) => !el.classList.contains("hidden")));
    };
    for (const t of tabs) t.addEventListener("click", () => { filter = t.dataset.filter!; apply(); history.replaceState(null, "", filter === "all" ? location.pathname : `?filter=${filter}`); });
    search?.addEventListener("input", apply);
    const initial = new URLSearchParams(location.search).get("filter");
    if (initial && tabs.some((t) => t.dataset.filter === initial)) { filter = initial; apply(); }
  }
</script>
