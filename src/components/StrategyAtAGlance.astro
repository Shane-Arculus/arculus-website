---
/**
 * StrategyAtAGlance — Figma 104:13320 → 207:18170 (A−), 118:12579 (BBB),
 * 120:1030 (PEP). Gradient band stepping down the ladder A− (1) → BBB (2) →
 * PEP (3). Four stats: 46px Medium white figure over 13px SemiBold orange label.
 * Desktop: four across, spaced; mobile: 2×2 grid, 32px figures.
 */
interface Props { items: readonly (readonly [string, string])[]; ladder: 1 | 2 | 3; }
const { items, ladder } = Astro.props;
---
<section class="text-white" style={`background: var(--gradient-ladder-${ladder});`}>
  <dl class="mx-auto grid max-w-site grid-cols-2 gap-x-4 gap-y-6 px-4 py-10 md:flex md:justify-between md:px-[140px] md:py-[72px]">
    {items.map(([value, label]) => (
      <div class="flex flex-col gap-1.5 md:gap-2.5">
        <dd class="order-1 text-h3 font-medium md:text-stat">{value}</dd>
        <dt class="order-2 text-[10px] font-semibold uppercase tracking-kicker text-orange md:text-stat-label">{label}</dt>
      </div>
    ))}
  </dl>
</section>
