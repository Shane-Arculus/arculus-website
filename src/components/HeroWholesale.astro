---
/**
 * HeroWholesale — the wholesale landing hero. Figma 130:2051 → 209:19003.
 * Navy radial gradient, orange kicker, Display title, 24 white subtitle, no
 * image; the Arculus mark outline (public/decor/cta-outline.svg) sits right.
 */
interface Props { kicker: string; title: string; subtitle: string; }
const { kicker, title, subtitle } = Astro.props;
---
<section class="relative overflow-hidden text-white" style="background: var(--gradient-navy-radial);">
  <img src="/decor/cta-outline.svg" alt="" aria-hidden="true" width="980" height="942" class="pointer-events-none absolute right-[-260px] top-[-220px] hidden w-[980px] max-w-none select-none opacity-45 md:block" />
  <div class="relative mx-auto flex max-w-site flex-col justify-center gap-4 px-4 py-10 md:min-h-[634px] md:gap-6 md:px-12 md:py-[110px]">
    <p class="text-kicker font-semibold uppercase tracking-kicker text-orange md:text-[14px]">{kicker}</p>
    <h1 class="text-display-sm font-medium md:text-display">{title}</h1>
    <p class="max-w-[760px] text-h6 md:text-h5">{subtitle}</p>
  </div>
</section>
