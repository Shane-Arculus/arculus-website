---
/**
 * QA 5 Oct (Jim): off the fund pages the bar names the two rated funds and states the rating's scope; copy column is flex-1 so the bar balances with or without the button.
 * RatingsRow — the Lonsec ratings bar. Figma desktop 244:9689 (three columns:
 * headline + disclosure · Lonsec wordmark + Investment Grade badge · Secondary
 * button); mobile 228:9407 (white card: "Ratings" title, disclosure, badge row,
 * full-width button). Lonsec only. Copy from site.json ratings; the report URL
 * is per fund (ratingReportUrl). Also used on Our approach (244:9709).
 */
import Button from "./Button.astro";
import { getSite } from "../content/loaders";
interface Props { reportUrl?: string; class?: string; }
const { reportUrl, class: className = "" } = Astro.props;
const { ratings } = await getSite();
---
<div class:list={["rounded-lg border border-card-line bg-white", className]}>
  <!-- Desktop: copy left (flex-1), Lonsec marks right, report button after them on fund pages -->
  <div class="hidden items-center justify-between gap-12 p-10 md:flex md:px-12">
    <div class="flex max-w-[640px] flex-1 flex-col gap-2">
      <p class="text-lead font-medium text-navy">{reportUrl ? ratings.headline : (ratings.headlineFunds ?? ratings.headline)}</p>
      {!reportUrl && ratings.scope && <p class="text-small text-navy">{ratings.scope}</p>}
      <p class="text-small text-body">{ratings.disclosure}</p>
    </div>
    <div class="flex shrink-0 items-center gap-8">
      <div class="flex items-center gap-5">
        <img src="/ratings/lonsec-wordmark.png" alt={ratings.lonsecAlt} width="138" height="88" class="h-[72px] w-auto" />
        <img src="/ratings/lonsec-investment-grade.png" alt={ratings.badgeAlt} width="92" height="92" class="h-[80px] w-[80px]" />
      </div>
      {reportUrl && <Button label={ratings.buttonLabel} href={reportUrl} style="secondary" />}
    </div>
  </div>
  <!-- Mobile -->
  <div class="flex flex-col gap-5 px-6 pb-6 pt-5 md:hidden">
    <div class="flex items-center gap-3.5">
      <img src="/ratings/lonsec-investment-grade.png" alt={ratings.badgeAlt} width="56" height="56" class="h-14 w-14 shrink-0" />
      <p class="text-body font-medium text-navy">{reportUrl ? ratings.headline : (ratings.headlineFunds ?? ratings.headline)}</p>
    </div>
    {!reportUrl && ratings.scope && <p class="text-small text-navy">{ratings.scope}</p>}
    <p class="text-small text-body">{ratings.disclosure}</p>
    {reportUrl && <Button label={ratings.buttonLabel} href={reportUrl} style="secondary" full />}
  </div>
</div>
