---
/**
 * Section — the standard band: full-width background, 1340 container,
 * 80/48 padding on desktop, 40/16 on mobile. Every content module uses it.
 */
interface Props extends astroHTML.JSX.HTMLAttributes { bg?: "white" | "cream" | "sand" | "navy-deep"; class?: string; id?: string; pad?: "default" | "tight" | "none"; }
const { bg = "white", class: className = "", id, pad = "default", ...rest } = Astro.props;
const bgs = { white: "bg-white", cream: "bg-cream", sand: "bg-sand", "navy-deep": "bg-navy-deep text-white" };
const pads = { default: "px-4 py-10 md:px-12 md:py-20", tight: "px-4 py-8 md:px-12 md:py-12", none: "" };
---
<section id={id} class:list={[bgs[bg], className]} {...rest}>
  <div class:list={["mx-auto max-w-site", pads[pad]]}><slot /></div>
</section>
