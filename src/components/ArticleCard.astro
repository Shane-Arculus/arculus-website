---
/**
 * ArticleCard — article-block (437×246 image, tag + date · reading time,
 * H5 title, body) and highlighted-article (775×436 image left, H1 title) from
 * insights-row 123:31761. `featured` switches layout. Links to the PDF.
 */
import Tag from "./Tag.astro";
import { fmtDate } from "../lib/format";
interface Props { article: { slug: string; category: string; date: string; title: string; homeTitle?: string; summary: string; homeSummary?: string; readingTime?: string | null; pdf: string; image?: string }; featured?: boolean; }
const { article: a, featured = false } = Astro.props;
const img = a.image && !a.image.startsWith("[") ? a.image : "/images/insight-placeholder.webp";
---
{featured ? (
  <a href={`/insights/${a.slug}/`} class="group flex flex-col gap-4 md:flex-row md:gap-4">
    <img src={img} alt="" width="775" height="436" loading="lazy" class="aspect-[775/436] w-full rounded-lg object-cover md:w-[775px] md:shrink-0" />
    <div class="flex flex-col gap-4 md:pl-4">
      <div class="flex items-center gap-2"><Tag label={a.category} /><span class="text-small text-body">{fmtDate(a.date)}</span></div>
      <div class="flex flex-col gap-4 md:gap-6">
        <h3 class="text-h5 font-medium text-navy group-hover:text-rust md:text-h2">{a.homeTitle ?? a.title}</h3>
        <p class="text-body text-body">{a.homeSummary ?? a.summary}</p>
      </div>
    </div>
  </a>
) : (
  <a href={`/insights/${a.slug}/`} class="group flex flex-col gap-[18px]">
    <img src={img} alt="" width="437" height="246" loading="lazy" class="aspect-[437/246] w-full rounded-lg object-cover" />
    <div class="flex flex-col gap-3">
      <div class="flex flex-wrap items-center gap-2 text-small text-body"><Tag label={a.category} /><span>{fmtDate(a.date)}</span>{a.readingTime && <><span aria-hidden="true" class="h-[11px] w-px bg-body"></span><span>{a.readingTime}</span></>}</div>
      <div class="flex flex-col gap-2.5 md:pr-4">
        <h3 class="text-h5 font-medium text-navy group-hover:text-rust">{a.homeTitle ?? a.title}</h3>
        <p class="text-body text-body">{a.homeSummary ?? a.summary}</p>
      </div>
    </div>
  </a>
)}
