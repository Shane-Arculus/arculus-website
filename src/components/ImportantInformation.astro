---
/**
 * ImportantInformation — the compliance band at the foot of every page.
 * Figma 123:31763 (generic), 88:994 (fund), 103:1344 (wholesale) → mobile 207:16558 etc.
 * Cream band, 80/48 padding desktop, 40/16 mobile, small body-grey text with a
 * 36px inner inset on desktop. Mobile frames show a section title; desktop none.
 *
 * variant generic: site.importantInformation.generic paragraphs.
 * variant fund: the fund template filled with {fundName} {arsn} {apir}.
 * variant wholesale: the wholesale template filled with {riskSubject} {asAt}, then the generic paragraphs.
 * Template text is verbatim compliance copy (site.json); only braces change.
 */
import { getSite, fill } from "../content/loaders";
type Props =
  | { variant: "generic" }
  | { variant: "fund"; fundName: string; arsn: string; apir: string }
  | { variant: "wholesale"; riskSubject: string; asAt: string | null };
const props = Astro.props as Props;
const site = await getSite();
const ii = site.importantInformation;
let paragraphs: string[] = [];
if (props.variant === "generic") paragraphs = ii.generic;
else if (props.variant === "fund") paragraphs = [fill(ii.fund.template, { fundName: props.fundName, arsn: props.arsn, apir: props.apir })];
else {
  // IM (170:3269) omits the "Portfolio figures…" sentence: drop it when there is no as-at date.
  const template = props.asAt ? ii.wholesale.template : ii.wholesale.template.replace(/\s*Portfolio figures[^.]*\.(?:[^.]*audited\.)?/, "");
  const first = fill(template, { riskSubject: props.riskSubject, asAt: props.asAt ?? "" });
  paragraphs = ii.wholesale.thenGeneric ? [first, ...ii.generic] : [first];
}
---
<section class="bg-cream" aria-labelledby="important-information-title">
  <div class:list={["mx-auto max-w-site px-4 py-10 md:py-20", props.variant === "generic" ? "md:flex md:gap-4 md:px-12" : "md:px-[84px]"]}>
    <h2 id="important-information-title" class:list={["mb-6 text-base font-medium text-navy", props.variant === "generic" ? "md:mb-0 md:w-[323px] md:shrink-0 md:text-small" : "md:sr-only"]}>{ii.title}</h2>
    <div class="flex flex-col gap-4 text-small text-body">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>
