---
/**
 * Pillars — "Why invest with Arculus" (Jim, 16 Oct 2026; Kapstream flow).
 * Cream band, four boxed white cards (card rule: rounded-lg + card-line on
 * cream), icon in a sand disc. Sits on Home after the fund cards and carries
 * the main route into About for visitors not ready to pick a fund.
 */
import Section from "./Section.astro";
import Icon from "./Icon.astro";
import Button from "./Button.astro";
type IconName = Parameters<typeof Icon>[0]["name"];
interface Props {
  title: string;
  intro: string;
  items: readonly { title: string; body: string; icon: string }[];
  button: { label: string; href: string };
  id?: string;
}
const { title, intro, items, button, id } = Astro.props;
---
<Section bg="cream" id={id}>
  <div class="flex flex-col gap-8 md:gap-12">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between md:gap-12">
      <div class="flex max-w-[760px] flex-col gap-4">
        <h2 class="text-h5 font-medium text-navy md:text-h3">{title}</h2>
        {intro.split("\n").map((line) => <p class="text-lead">{line}</p>)}
      </div>
      <div class="hidden shrink-0 md:block"><Button label={button.label} href={button.href} style="primary" /></div>
    </div>
    <ul class="grid gap-4 md:grid-cols-4 md:gap-6">
      {items.map((it) => (
        <li class="flex flex-col gap-4 rounded-lg border border-card-line bg-white p-6 md:gap-5 md:p-8">
          <span class="flex size-12 items-center justify-center rounded-full bg-sand text-rust-hi"><Icon name={it.icon as IconName} size={24} /></span>
          <h3 class="text-lead font-medium text-navy">{it.title}</h3>
          <p>{it.body}</p>
        </li>
      ))}
    </ul>
    <div class="md:hidden"><Button label={button.label} href={button.href} style="primary" full /></div>
  </div>
</Section>
