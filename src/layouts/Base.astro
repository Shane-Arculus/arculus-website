---
/**
 * Base layout — every page renders through this.
 * Header (T4) and Footer (T5) slot in above and below <main> later; nothing else changes here.
 */
interface Props {
  title: string;
  description: string;
  /** Set true on staging and gated/unverified pages. */
  noindex?: boolean;
  /** Exclude from the site search index (gated pages, 404, search itself). */
  nosearch?: boolean;
  /** Path to a page-specific Open Graph image; defaults to the site card. */
  ogImage?: string;
}
const { title, description, noindex: noindexProp = false, nosearch = false, ogImage = "/og/default.png" } = Astro.props;
// Preview builds (PUBLIC_ALLOW_UNVERIFIED=1) are noindexed on every page automatically, so the production build on `main` cannot ship noindexed by accident (security review, 23 Sep). Pages that must never be indexed pass `noindex` themselves.
const noindex = noindexProp || import.meta.env.PUBLIC_ALLOW_UNVERIFIED === "1";
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://arculus.com.au").href;
const ogAbs = new URL(ogImage, Astro.site ?? "https://arculus.com.au").href;
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN as string | undefined;
import "../styles/global.css";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Arculus Funds Management" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.png" sizes="64x64" />
    <link rel="preload" href="/fonts/FiraSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/FiraSans-Medium.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="min-h-dvh flex flex-col">
    <div data-pagefind-ignore><slot name="header" /></div>
    <main id="main" class="flex-1" data-pagefind-body={nosearch ? undefined : ""} data-pagefind-ignore={nosearch ? "" : undefined}>
      <slot />
    </main>
    <div data-pagefind-ignore><slot name="footer" /></div>
    {analyticsToken && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${analyticsToken}"}`}></script>
    )}
  </body>
</html>
