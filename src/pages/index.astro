---
/**
 * Home — Figma 01A · Homepage Alt 123:31753 → 207:16548.
 * Order: header · hero-level-1 · fund-cards · important-disclosure · left-right
 * · product-cards · insights-row · important-information (generic) · footer.
 */
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeroLevel1 from "../components/HeroLevel1.astro";
import FundCards from "../components/FundCards.astro";
import ImportantDisclosure from "../components/ImportantDisclosure.astro";
import LeftRight from "../components/LeftRight.astro";
import ProductCards from "../components/ProductCards.astro";
import InsightsRow from "../components/InsightsRow.astro";
import ImportantInformation from "../components/ImportantInformation.astro";
import { getPage, getSite, getFund, getArticle, getInsights } from "../content/loaders";

const home = await getPage("home");
const site = await getSite();
const fundHref = { afi: "/funds/arculus-fixed-income-fund", pif: "/funds/arculus-preferred-income-fund" } as const;
const cards = await Promise.all(home.funds.cards.map(async (c) => ({
  ...c, href: fundHref[c.fund], investHref: site.externalUrls.olivia123,
  image: { src: `/images/card-${c.fund}.webp`, alt: `[image register ${c.fund === "afi" ? "IMG-02" : "IMG-03"}]` },
})));
const featured = await getArticle(home.insights.featured);
// Home row rule (Jim, 4 Oct): the featured paper, then the latest weekly update and the two most recent non-weekly items — so the weekly cadence never buries the research. home.insights.list is no longer used.
const ins = await getInsights();
const sorted = [...ins.articles].filter((a) => a.slug !== home.insights.featured).sort((a, b) => b.date.localeCompare(a.date));
const latestWeekly = sorted.find((a) => a.category === "Weekly update");
const list = [latestWeekly, ...sorted.filter((a) => a.category !== "Weekly update").slice(0, 2)].filter(Boolean) as typeof sorted;
const aboutHref = home.leftRightButton.href;
---
<Base title="Arculus Funds Management — Income management that preserves capital" description={home.hero.subtitle}>
  <Header slot="header" />
  <HeroLevel1 title={home.hero.title} subtitle={home.hero.subtitle} buttons={home.hero.buttons} image={{ src: "/images/hero-home.webp", alt: "[image register IMG-01]" }} />
  <FundCards id="funds" title={home.funds.title} cards={cards} buttons={home.funds.cardButtons} showRatings={home.funds.showRatings} />
  <ImportantDisclosure />
  <LeftRight blocks={home.leftRight.map((lr) => ({ title: lr.title, paragraphs: [lr.body] }))} image={{ src: "/images/left-right-city.webp", alt: "[image register IMG-04]" }} button={{ label: home.leftRightButton.label, href: aboutHref, style: "secondary" }} />
  <ProductCards title={home.productCards.title} cards={home.productCards.cards} />
  <InsightsRow title={home.insights.title} button={home.insights.button} featured={featured} list={list} />
  <ImportantInformation variant="generic" />
  <Footer slot="footer" />
</Base>
