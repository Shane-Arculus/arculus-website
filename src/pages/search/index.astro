---
/**
 * Search — Figma 191:4941 → 210:14701. SearchInput header, FilterTabs (All /
 * Pages / Documents / Insights, by result URL), results rendered client-side
 * from Pagefind (index built after `astro build`). Gated pages and this page
 * are excluded from the index (Base `nosearch`).
 */
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import SearchInput from "../../components/SearchInput.astro";
import ImportantInformation from "../../components/ImportantInformation.astro";
import Icon from "../../components/Icon.astro";
import { getPage } from "../../content/loaders";
import { slugify } from "../../lib/format";
const sp = await getPage("search");
---
<Base title={`${sp.title} — Arculus Funds Management`} description={sp.title} noindex nosearch>
  <Header slot="header" />
  <Breadcrumb items={sp.breadcrumb} />
  <SearchInput title={sp.title} placeholder={sp.placeholder} buttonLabel={sp.button} />
  <section class="bg-white" data-search data-labels={JSON.stringify({ results: sp.resultsLabel, empty: sp.emptyLabel, prompt: sp.promptLabel, loading: sp.loadingLabel, kickers: sp.kickers })}>
    <div class="mx-auto max-w-site px-4 pb-16 md:px-12 md:pb-24">
      <div class="max-w-[888px]">
        <div role="tablist" class="flex gap-6 border-b border-line pb-3 pt-6 md:gap-8">
          {sp.filters.map((f, i) => <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-sfilter={i === 0 ? "all" : slugify(f)} class="shrink-0 text-body hover:text-navy aria-selected:font-semibold aria-selected:text-rust">{f}</button>)}
        </div>
        <p class="py-6 text-body" data-search-status aria-live="polite">{sp.promptLabel}</p>
        <ul data-search-results></ul>
        <button type="button" class="mt-6 hidden items-center gap-1 font-medium text-rust hover:underline" data-search-more>{sp.loadMore}<Icon name="chevron-down" size={14} /></button>
      </div>
    </div>
  </section>
  <ImportantInformation variant="generic" />
  <Footer slot="footer" />
</Base>
<script is:inline>
  const root = document.querySelector("[data-search]");
  if (root) {
    const labels = JSON.parse(root.dataset.labels);
    const status = root.querySelector("[data-search-status]");
    const list = root.querySelector("[data-search-results]");
    const more = root.querySelector("[data-search-more]");
    const tabs = Array.from(root.querySelectorAll("[data-sfilter]"));
    const statusLine = root.parentElement?.querySelector("[aria-live]");
    let filter = "all", results = [], shown = 0;
    const kind = (url) => (url.startsWith("/documents") ? "document" : url.startsWith("/insights") ? "insight" : "page");
    const kicker = (k, meta) => (k === "insight" ? labels.kickers.insight.replace("{category}", meta?.category ?? "") : k === "document" ? labels.kickers.document : labels.kickers.page);
    const render = async () => {
      const rows = results.filter((r) => filter === "all" || r.kind + "s" === filter);
      const batch = rows.slice(0, shown + 10);
      list.innerHTML = "";
      for (const r of batch) {
        const d = await r.data();
        const li = document.createElement("li"); li.className = "flex flex-col gap-1.5 border-b border-line py-7";
        li.innerHTML = `<p class="text-kicker font-semibold uppercase tracking-kicker text-rust"></p><h3 class="text-base-lg font-medium text-navy leading-[1.3]"><a class="hover:text-rust"></a></h3><p></p><p class="text-small text-body"></p>`;
        li.querySelector("p").textContent = kicker(r.kind, d.meta);
        const a = li.querySelector("a"); a.href = d.url; a.textContent = d.meta?.title ?? d.url;
        li.querySelectorAll("p")[1].innerHTML = d.excerpt; li.querySelectorAll("p")[2].textContent = `arculus.com.au${d.url}`;
        list.appendChild(li);
      }
      shown = batch.length;
      more.classList.toggle("hidden", shown >= rows.length); more.classList.toggle("inline-flex", shown < rows.length);
      status.textContent = rows.length ? "" : labels.empty.replace("{q}", q);
    };
    const q = new URLSearchParams(location.search).get("q")?.trim() ?? "";
    const input = document.querySelector("#q"); if (input) input.value = q;
    for (const t of tabs) t.addEventListener("click", () => { filter = t.dataset.sfilter; for (const x of tabs) x.setAttribute("aria-selected", String(x === t)); shown = 0; render(); });
    more.addEventListener("click", () => render());
    (async () => {
      if (!q) return;
      status.textContent = labels.loading;
      try {
                const pf = await import("/pagefind/pagefind.js");
        await pf.init();
        const res = await pf.search(q);
        results = [];
        for (const r of res.results) { const d = await r.data(); results.push({ data: () => Promise.resolve(d), kind: kind(d.url) }); }
        if (statusLine) statusLine.textContent = labels.results.replace("{n}", String(results.length)).replace("{q}", q);
        await render();
      } catch (e) { console.error("search", e); status.textContent = labels.empty.replace("{q}", q); }
    })();
  }
</script>
