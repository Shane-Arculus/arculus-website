---
/**
 * Component gallery — preview environments only. Built only when
 * PUBLIC_ALLOW_UNVERIFIED=1, so it never exists on production.
 */
import Base from "../../layouts/Base.astro";
import KeyValueList from "../../components/KeyValueList.astro";
import ChartImage from "../../components/ChartImage.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ImportantInformation from "../../components/ImportantInformation.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import HeroLevel1 from "../../components/HeroLevel1.astro";
import HeroLevel2 from "../../components/HeroLevel2.astro";
import HeroWholesale from "../../components/HeroWholesale.astro";
import Statement from "../../components/Statement.astro";
import StrategyAtAGlance from "../../components/StrategyAtAGlance.astro";
import ContentColumns from "../../components/ContentColumns.astro";
import TwoColumnsContent from "../../components/TwoColumnsContent.astro";
import LeftRight from "../../components/LeftRight.astro";
import FundOverviewPerformance from "../../components/FundOverviewPerformance.astro";
import Documents from "../../components/Documents.astro";
import KeyDocuments from "../../components/KeyDocuments.astro";
import ProfileModule from "../../components/ProfileModule.astro";
import ProductCards from "../../components/ProductCards.astro";
import InsightsRow from "../../components/InsightsRow.astro";
import InsightsList from "../../components/InsightsList.astro";
import FilterTabs from "../../components/FilterTabs.astro";
import SearchInput from "../../components/SearchInput.astro";
import SearchResultRow from "../../components/SearchResultRow.astro";
import ThreeColumnsContactBanner from "../../components/ThreeColumnsContactBanner.astro";
import ContactForm from "../../components/ContactForm.astro";
import SubscribeModal from "../../components/SubscribeModal.astro";
import AttestationModal from "../../components/AttestationModal.astro";
import { getInsights, getArticle } from "../../content/loaders";
import { getDocuments, getDoc } from "../../content/loaders";
import { getPage, getAbout, getWholesaleLanding } from "../../content/loaders";
import { getStrategy } from "../../content/loaders";
import Button from "../../components/Button.astro";
import { getFund } from "../../content/loaders";

export function getStaticPaths() {
  return process.env.PUBLIC_ALLOW_UNVERIFIED === "1" ? [{ params: {} }] : [];
}
const afi = await getFund("afi");
const a = await getStrategy("a-minus");
const home = await getPage("home");
const approach = await getAbout("approach");
const wl = await getWholesaleLanding();
const team = await getAbout("team");
const ins = await getInsights();
const featured = await getArticle(home.insights.featured);
const rowList = await Promise.all(home.insights.list.map(getArticle));
const searchPage = await getPage("search");
const afiDocs = await Promise.all(afi.documents.items.map((id) => getDoc(id)));
const lib = await getDocuments();
const allAfi = lib.documents.filter((d) => d.fund === "afi");
---
<Base title="Component gallery" description="Preview-only component gallery." noindex nosearch>
  <Header slot="header" />
  <Footer slot="footer" />
  <HeroLevel1 title={home.hero.title} subtitle={home.hero.subtitle} buttons={home.hero.buttons} image={{ src: "/images/hero-home.webp", alt: "[image register IMG-01]" }} />
  <HeroLevel2 title={afi.hero.title} description={afi.hero.subtitle} theme="light" layout="full" bg="afi" titleColor="rust" buttons={afi.hero.buttons.map((b) => ({ ...b, href: b.href === "olivia123" ? "#" : "#" }))} image={{ src: "/images/hero-afi.webp", alt: "[image register IMG-02]" }}>
    <div class="flex flex-col gap-6 text-navy md:pt-2">
      <div><p class="text-body">{afi.hero.facts[0].label}</p><p class="text-h5 font-medium md:text-h3">{afi.hero.facts[0].value}</p><p class="text-body">{afi.hero.facts[0].note}</p></div>
      <dl class="flex flex-col gap-2 md:flex-row md:gap-4">{afi.hero.facts.slice(1).map((f) => <div class="flex gap-1.5 border-l border-line-secondary pl-4 md:flex-col md:gap-0"><dt class="text-body">{f.label}</dt><dd class="text-body font-medium">{f.value}</dd></div>)}</dl>
    </div>
  </HeroLevel2>
  <HeroLevel2 title={approach.hero.title} description={approach.hero.subtitle} theme="light" layout="compact" bg="compact" buttons={[approach.hero.button]} image={{ src: "/images/hero-afi.webp", alt: "[image register IMG-02]" }} />
  <HeroLevel2 title={a.hero.title} description={a.hero.subtitle} kicker={a.kicker} theme="navy" layout="full" buttons={[a.hero.button]} stats={a.hero.facts} image={{ src: "/images/hero-a-minus.webp", alt: "[image register IMG-09]" }} />
  <HeroWholesale kicker={wl.hero.kicker} title={wl.hero.title} subtitle={wl.hero.subtitle} />
  <Breadcrumb items={afi.breadcrumb} />
  <FundOverviewPerformance about={afi.about} ratingReportUrl={afi.ratings.ratingReportUrl} performance={afi.performance} fundName={afi.name} />
  <KeyDocuments title={afi.keyDocuments.title} items={afi.keyDocuments.items.map((k) => ({ title: k.title, meta: k.meta, href: "#" }))} />
  <Documents title={afi.documents.title} intro={afi.documents.intro} items={afiDocs.map((d) => ({ title: d.title, href: d.path }))} viewAll={{ label: afi.documents.button.label, href: afi.documents.button.href ?? "/documents" }} />
  <Documents title={lib.page.sections[0].title} intro={lib.page.sections[0].intro} items={allAfi.map((d) => ({ title: d.title, href: d.path, meta: d.meta }))} collapseAfter={5} bg="cream" />
  <ProfileModule title={team.groups[0].title} intro={team.groups[0].intro} people={team.groups[0].people.map((p) => ({ ...p, photo: "/images/team-placeholder.webp" }))} />
  <ProductCards title={home.productCards.title} cards={home.productCards.cards} />
  <InsightsRow title={home.insights.title} button={home.insights.button} featured={featured} list={rowList} />
  <FilterTabs tabs={ins.page.filters} target="insights-list" />
  <InsightsList id="insights-list" title={ins.page.listTitle} articles={ins.articles} readLabel={ins.page.readLabel} emptyLabel="No insights in this category yet." />
  <ThreeColumnsContactBanner title={afi.howToInvest.title} columns={afi.howToInvest.columns.map((c) => ({ ...c, button: { ...c.button, href: c.button.href === "olivia123" ? "#" : c.button.href } }))} />
  <ContactForm />
  <section class="bg-cream"><div class="mx-auto flex max-w-site gap-4 px-4 py-8 md:px-12"><Button label="Open subscribe modal" data-open-subscribe /><Button label="Open attestation (clears session)" id="dev-attest" style="secondary" /></div></section>
  <SubscribeModal />
  <AttestationModal />
  <script>document.getElementById("dev-attest")?.addEventListener("click",()=>{sessionStorage.removeItem("arculus-wholesale-attested");location.reload();});</script>
  <SearchInput title={searchPage.title} buttonLabel={searchPage.button} query="duration" resultsLine={searchPage.resultsLabel.replace("{n}", "3").replace("{q}", "duration")} />
  <section class="bg-white"><div class="mx-auto max-w-site px-4 pb-16 md:px-12 md:pb-24"><ul class="max-w-[888px]">
    <SearchResultRow kicker={searchPage.kickers.page} title="Our approach" href="/about/our-approach" snippet="…Duration is set by where we are in the cycle, not by an index…" source="arculus.com.au/about/our-approach" />
    <SearchResultRow kicker={searchPage.kickers.document} title="Arculus Fixed Income Fund — Monthly report, July 2026" href="#" snippet="…portfolio duration extended modestly over the month…" source="Document library" />
    <SearchResultRow kicker={searchPage.kickers.insight.replace("{category}", "Research note")} title="Taylor Rule sensitivity analysis: United States and Australia" href="#" snippet="…the rule's prescription is far more sensitive to where core PCE prints…" source="Insights · 13 Jul 2026" />
  </ul></div></section>
  <Statement title={a.statement.title} points={a.statement.points} footnote={a.statement.footnote} />
  <StrategyAtAGlance items={a.strategyAtAGlance} ladder={1} />
  <ContentColumns title={a.processRiskControls.title} items={a.processRiskControls.items} />
  <TwoColumnsContent title={a.keyRisks.title} paragraphs={a.keyRisks.paragraphs} />
  <LeftRight title={approach.whoWeAre.title} paragraphs={approach.whoWeAre.paragraphs} image={{ src: "/images/left-right-city.webp", alt: "[image register IMG-04]" }} />
  <section class="bg-cream">
    <div class="mx-auto max-w-site px-4 py-12 md:px-12">
      <h1 class="text-h2 font-medium text-navy">Component gallery</h1>
      <p class="mt-2 text-body text-body">Preview builds only. T3: KeyValueList and ChartImage. T4: Header, Button, Icon. T5: Footer. T6: Breadcrumb, ImportantInformation, CtaBanner. T7: HeroLevel1, HeroLevel2, HeroWholesale, HeroImage. T8: Statement, StrategyAtAGlance, ContentColumns, TwoColumnsContent, LeftRight, Section. T9: FundOverviewPerformance, RatingsRow. T10: Documents, DownloadSlice, KeyDocuments, ProfileModule, ProductCards. T11: InsightsRow, ArticleCard, Tag, InsightsList, FilterTabs, SearchInput, SearchResultRow. T12: ThreeColumnsContactBanner, ContactForm, FormField, SubscribeModal, AttestationModal.</p>
      <div class="mt-6 flex flex-wrap gap-4"><Button label="Primary" href="#" /><Button label="Secondary" href="#" style="secondary" /><Button label="External" href="#" style="external" /></div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-site px-4 py-12 md:px-12 grid gap-8 md:grid-cols-2">
      <div class="bg-white p-6 md:p-9 md:pt-6">
        <h2 class="text-lead font-medium text-navy mb-6">{afi.features.title}</h2>
        <KeyValueList rows={afi.features.items} caption={afi.features.title} />
      </div>
      <div>
        <ChartImage src={afi.performance.chartImage} alt={`${afi.performance.chartTitle}, ${afi.name}, to ${afi.performance.performanceAsAt}`} title={afi.performance.chartTitle} series={afi.performance.chartSeries} />
        <KeyValueList class="mt-6" rows={afi.portfolio.metrics} title={afi.performance.tableTitle} variant="table" />
      </div>
    </div>
  </section>

  <section class="bg-cream">
    <div class="mx-auto max-w-site px-4 py-12 md:px-12 md:max-w-[664px]">
      <KeyValueList rows={afi.portfolio.metrics} title={afi.portfolio.title} />
    </div>
  </section>
  <CtaBanner title={a.cta.title} body={a.cta.body} button={a.cta.button} />
  <ImportantInformation variant="fund" fundName={afi.name} arsn={afi.regulatory.arsn} apir={afi.regulatory.apir} />
</Base>
