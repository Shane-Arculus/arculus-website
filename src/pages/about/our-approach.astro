---
/** Our approach — Figma 157:11833 → 208:12136. */
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import HeroLevel2 from "../../components/HeroLevel2.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import LeftRight from "../../components/LeftRight.astro";
import ContentColumns from "../../components/ContentColumns.astro";
import TwoColumnsContent from "../../components/TwoColumnsContent.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import ImportantInformation from "../../components/ImportantInformation.astro";
import { getAbout } from "../../content/loaders";
const a = await getAbout("approach");
---
<Base title={`${a.hero.title} — Arculus Funds Management`} description={a.hero.subtitle}>
  <Header slot="header" />
  <HeroLevel2 title={a.hero.title} description={a.hero.subtitle} theme="light" layout="compact" bg="compact" buttons={[a.hero.button]} image={{ src: "/images/hero-approach.webp", alt: "[image register IMG-02]" }} height="short" />
  <Breadcrumb items={a.breadcrumb} bg="white" />
  <ContentColumns title={a.philosophy.title} items={a.philosophy.items.map((it) => (it[0] === "Independent oversight" ? [it[0], it[1], a.philosophy.link] as const : it[0] === "ESG" ? [it[0], it[1], a.philosophy.esgLink] as const : it))} columns={3} split={3} pad="tight" bg="white" />
  <LeftRight title={a.whoWeAre.title} paragraphs={a.whoWeAre.paragraphs} image={{ src: "/images/left-right-about.webp", alt: "Sandstone escarpments at sunset, seen from a ridge through gum branches" }} pad="tight" compact />
  <TwoColumnsContent columns={[{ title: a.whatWeDo.title, items: a.whatWeDo.items }, { title: a.forOurClients.title, items: a.forOurClients.items }]} pad="tight" />
  <CtaBanner title={a.cta.title} body={a.cta.body} button={a.cta.button} />
  <ImportantInformation variant="generic" />
  <Footer slot="footer" />
</Base>
