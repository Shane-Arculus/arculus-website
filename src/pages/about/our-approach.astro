---
/** Our approach (About) — Figma 157:11833 → 208:12136; reworked 16 Oct 2026 as the second half of the Home → About flow: hero · Who we are + quick links · Four eyes · How we invest · CTA. */
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import HeroLevel2 from "../../components/HeroLevel2.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import AboutIntro from "../../components/AboutIntro.astro";
import FourEyes from "../../components/FourEyes.astro";
import ContentColumns from "../../components/ContentColumns.astro";
import Section from "../../components/Section.astro";
import Icon from "../../components/Icon.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import ImportantInformation from "../../components/ImportantInformation.astro";
import { getAbout } from "../../content/loaders";
const a = await getAbout("approach");
const g = await getAbout("governance");
---
<Base title={`${a.hero.title} — Arculus Funds Management`} description={a.hero.subtitle}>
  <Header slot="header" />
  <HeroLevel2 title={a.hero.title} description={a.hero.subtitle} theme="light" layout="compact" bg="compact" buttons={[a.hero.button]} image={{ src: "/images/hero-approach.webp", alt: "[image register IMG-02]" }} height="short" />
  <Breadcrumb items={a.breadcrumb} bg="white" />
  <AboutIntro title={a.whoWeAre.title} showTitle={a.whoWeAre.showTitle ?? true} paragraphs={a.whoWeAre.paragraphs} quickLinks={a.quickLinks ?? []} sub={a.whoWeAre.philosophy} />
  {a.fourEyes && <FourEyes id="four-eyes" title={a.fourEyes.title} intro={a.fourEyes.intro} link={a.fourEyes.link} roles={g.fourRoles.items} />}
  <ContentColumns id="how-we-invest" title={a.philosophy.title} items={a.philosophy.items} columns={4} split={a.philosophy.items.length} pad="tight" bg="white" />
  {a.esg && (
    <Section bg="white" pad="tight" id="esg">
      <div class="flex flex-col gap-6 md:grid md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] md:gap-24 md:px-12">
        <h2 class="text-h5 font-medium text-navy md:text-h3">{a.esg.title}</h2>
        <div class="flex flex-col gap-4">
          {a.esg.paragraphs.map((p) => <p class="text-lead">{p}</p>)}
          <a href={a.esg.link.href} class="inline-flex items-center gap-1 self-start font-medium text-rust hover:underline">{a.esg.link.label}<Icon name="chevron-right" size={14} /></a>
        </div>
      </div>
    </Section>
  )}
  <CtaBanner title={a.cta.title} body={a.cta.body} button={a.cta.button} />
  <ImportantInformation variant="generic" />
  <Footer slot="footer" />
</Base>
